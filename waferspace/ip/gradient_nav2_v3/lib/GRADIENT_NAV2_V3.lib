library (GRADIENT_NAV2_V3) {
  comment                        : "Black-box view of an analog macro. No timing arcs on purpose.";
  delay_model                    : table_lookup;
  time_unit                      : "1ns";
  voltage_unit                   : "1V";
  current_unit                   : "1mA";
  capacitive_load_unit (1, pf);
  pulling_resistance_unit        : "1kohm";
  leakage_power_unit             : "1nW";
  nom_voltage                    : 5.0;
  nom_temperature                : 25.0;
  nom_process                    : 1.0;
  input_threshold_pct_rise       : 50.0;
  input_threshold_pct_fall       : 50.0;
  output_threshold_pct_rise      : 50.0;
  output_threshold_pct_fall      : 50.0;
  slew_lower_threshold_pct_rise  : 30.0;
  slew_upper_threshold_pct_rise  : 70.0;
  slew_lower_threshold_pct_fall  : 30.0;
  slew_upper_threshold_pct_fall  : 70.0;
  slew_derate_from_library       : 0.5;

  cell (GRADIENT_NAV2_V3) {
    is_macro_cell : true;
    dont_touch    : true;
    dont_use      : true;
    interface_timing : true;
    pin (S1N) {
      direction   : input;
      capacitance : 0.01;
    }
    pg_pin (VDD) {
      voltage_name : "VDD";
      pg_type      : primary_power;
    }
    pin (XP) {
      direction   : output;
      capacitance : 0.01;
    }
    pg_pin (VSS) {
      voltage_name : "VSS";
      pg_type      : primary_ground;
    }
    pin (S1P) {
      direction   : input;
      capacitance : 0.01;
    }
    pin (S2N) {
      direction   : input;
      capacitance : 0.01;
    }
    pin (S2P) {
      direction   : input;
      capacitance : 0.01;
    }
    pin (S3N) {
      direction   : input;
      capacitance : 0.01;
    }
    pin (S3P) {
      direction   : input;
      capacitance : 0.01;
    }
    pin (S4N) {
      direction   : input;
      capacitance : 0.01;
    }
    pin (S4P) {
      direction   : input;
      capacitance : 0.01;
    }
    pin (XN) {
      direction   : output;
      capacitance : 0.01;
    }
    pin (YP) {
      direction   : output;
      capacitance : 0.01;
    }
    pin (YN) {
      direction   : output;
      capacitance : 0.01;
    }
    pin (ZP) {
      direction   : output;
      capacitance : 0.01;
    }
    pin (ZN) {
      direction   : output;
      capacitance : 0.01;
    }
    pin (X) {
      direction   : output;
      capacitance : 0.01;
    }
    pin (Y) {
      direction   : output;
      capacitance : 0.01;
    }
    pin (Z) {
      direction   : output;
      capacitance : 0.01;
    }
  }
}
